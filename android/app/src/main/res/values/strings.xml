    <!-- Welcome / onboarding -->
    <string name="welcome_title">A quiet pause before distracting apps</string>
    <string name="welcome_body">Momentwise doesn\'t block apps or lock you out. It gives you a calm moment to ask why you tapped an app, and gentle reminders so you don\'t lose an hour by accident.</string>
    <string name="welcome_point_1"><b>Choose your apps:</b> Pick which apps pause when opened.</string>
    <string name="welcome_point_2"><b>Customise your prompt:</b> Write your own question and response options.</string>
    <string name="welcome_point_3"><b>Respectful reminders:</b> Set how often to check in, or turn them off completely.</string>
    <string name="welcome_get_started">Configure Your First App</string>
    <string name="welcome_skip">Go to Overview</string>

    <!-- Home -->
    <string name="home_summary_eyebrow">Sample configuration</string>
    <string name="home_summary_desc_sample">Opening pauses and check-in reminders from the seeded sample apps. Device app detection is not connected yet in this build.</string>
    <string name="home_summary_desc_empty">Select an app in the Apps tab to configure a mindful pause rule.</string>
    <string name="home_manage_apps">Manage Apps</string>
    <string name="home_test_section_title">Test Your Active Rules</string>
    <string name="home_test_section_meta">In-app preview</string>
    <string name="home_test_section_sub">Experience how your configured notices and button options will look and feel when opened.</string>
    <string name="home_test_opening">Test Opening Notice</string>
    <string name="home_test_reminder">Test In-App Reminder</string>
    <string name="home_how_title">How Momentwise Works</string>
    <string name="home_how_step_1"><b>Enable an app:</b> Pick distracting social or news apps in the Apps tab.</string>
    <string name="home_how_step_2"><b>Set your prompt:</b> Write a question that makes you pause before opening.</string>
    <string name="home_how_step_3"><b>Check in gracefully:</b> If you stay in the app, a gentle nudge helps you leave.</string>

    <!-- Apps -->
    <string name="apps_title">Apps</string>
    <string name="apps_heading">Configure App Rules</string>
    <string name="apps_subtext">Toggle an app to enable its mindful interruption rule, or tap anywhere on an app to customise its notice and reminders.</string>
    <string name="apps_sample_banner">Sample apps: real device app detection is not connected in this foundation build. Rules, notices, and reminders are fully functional.</string>
    <string name="apps_tip">Each app has its own independent rule, opening prompt, and reminder schedule.</string>
    <string name="apps_status_not_guarded">Not guarded</string>
    <string name="apps_status_opening_only">Rule active • Opening pause only</string>

